<wdkModel>

  <recordClassSet name="UserCommentRecords">

    <recordClass name="UserComment" urlName="user-comment" displayName="User Comment"
                 shortDisplayName="Comment" doNotTest="true" useBasket="false">

      <primaryKey aliasPluginClassName="org.gusdb.wdk.model.record.GenericRecordPrimaryKeyAliasPlugin">
        <columnRef>comment_id</columnRef>
      </primaryKey>

      <idAttribute name="primary_key" displayName="Comment ID">
        <text>
          <![CDATA[ $$comment_id$$ ]]>
        </text>
      </idAttribute>

      <attributesList includeProjects="UniDB"
        summary="headline, type, comment_date, user_name, is_ai_generated, project_id"
        sorting="comment_date desc"
        />

      <attributesList excludeProjects="UniDB"
        summary="headline, type, comment_date, user_name, is_ai_generated"
        sorting="comment_date desc"
        />

      <attributeQueryRef ref="UserCommentAttributes.CommentMetaData">
        <columnAttribute name="comment_date" displayName="Date"/>
        <columnAttribute name="user_name" displayName="User Name">
          <reporter name="histogram" displayName="Histogram" scopes=""
                    implementation="org.gusdb.wdk.model.report.reporter.HistogramAttributeReporter">
            <description>Display the histogram of the values of this attribute</description>
          </reporter>
        </columnAttribute>
        <columnAttribute name="organization" displayName="Organization">
          <reporter name="histogram" displayName="Histogram" scopes=""
                    implementation="org.gusdb.wdk.model.report.reporter.HistogramAttributeReporter">
            <description>Display the histogram of the values of this attribute</description>
          </reporter>
        </columnAttribute>
        <columnAttribute name="email" displayName="Email">
          <reporter name="histogram" displayName="Histogram" scopes=""
                    implementation="org.gusdb.wdk.model.report.reporter.HistogramAttributeReporter">
            <description>Display the histogram of the values of this attribute</description>
          </reporter>
	  
        </columnAttribute>
        <columnAttribute name="headline" displayName="Headline" internal="true"/>
        <columnAttribute name="sample_id" displayName="Sample ID" internal="true"/>
        <linkAttribute name="headline_link" displayName="Headline">
          <displayText>
            <![CDATA[
                     $$headline$$
            ]]>
          </displayText>
          <url>
            <![CDATA[
              a/app/user-comments/show?projectId=$$project_id$$&stableId=$$sample_id$$&commentTargetId=$$type$$#$$comment_id$$
	    ]]>
          </url>
        </linkAttribute>
        <columnAttribute name="type" displayName="Type">
          <reporter name="histogram" displayName="Histogram" scopes=""
                    implementation="org.gusdb.wdk.model.report.reporter.HistogramAttributeReporter">
            <description>Display the histogram of the values of this attribute</description>
          </reporter>
        </columnAttribute>
        <columnAttribute name="project_id" displayName="Project">
          <reporter name="histogram" displayName="Histogram" scopes=""
                    implementation="org.gusdb.wdk.model.report.reporter.HistogramAttributeReporter">
            <description>Display the histogram of the values of this attribute</description>
          </reporter>
        </columnAttribute>
        <columnAttribute name="is_ai_generated" displayName="AI Generated?">
          <reporter name="histogram" displayName="Histogram" scopes=""
                    implementation="org.gusdb.wdk.model.report.reporter.HistogramAttributeReporter">
            <description>Display the histogram of the values of this attribute</description>
          </reporter>
        </columnAttribute>
      </attributeQueryRef>

    </recordClass>

  </recordClassSet>

  <querySet name="UserCommentAttributes" queryType="attribute" isCacheable="false">
    <sqlQuery name="CommentMetaData" doNotTest="true" isCacheable="false">
      <column name="comment_id"/>
      <column name="comment_date"/>
      <column name="user_name"/>
      <column name="organization"/>
      <column name="email"/>
      <column name="headline"/>
      <column name="type"/>
      <column name="project_id"/>
      <column name="is_ai_generated"/>
      <column name="sample_id"/>
      <sql>
        <![CDATA[
          SELECT c.comment_id,
                 to_char(c.comment_date, 'YYYY-MM-DD HH24:MI') || ' (EST)' AS comment_date,
                 CONCAT(u.first_name, ' ', u.last_name) AS user_name,
                 u.organization,
                 c.email,
                 c.headline,
                 c.comment_target_id AS type,
                 c.project_name AS project_id,
                 CASE WHEN aiprov.comment_id IS NULL THEN 'No' ELSE 'Yes' END AS is_ai_generated,
                 CASE c.comment_target_id
                   WHEN 'gene' THEN (
                     SELECT gid.gene FROM apidbtuning.GeneId gid
                     WHERE gid.id = c.stable_id AND gid.unique_mapping = 1
                     LIMIT 1
                   )
                   WHEN 'genome' THEN (
                     SELECT gsid.sequence FROM webready.GenomicSequenceId_p gsid
                     WHERE gsid.id = c.stable_id
                     LIMIT 1
                   )
                   ELSE c.stable_id
                 END AS sample_id
          FROM @REMOTE_COMMENT_SCHEMA@comments c
            LEFT JOIN @REMOTE_COMMENT_SCHEMA@comment_users u ON c.user_id = u.user_id
            LEFT JOIN @REMOTE_COMMENT_SCHEMA@comment_ai_provenance aiprov ON c.comment_id = aiprov.comment_id
        ]]>
      </sql>
    </sqlQuery>
  </querySet>

</wdkModel>
