<wdkModel>

  <paramSet name="UserCommentParams">

    <dateRangeParam name="date"
                    prompt="Choose start and end dates."
                    minDate="2000-01-01"
                    maxDate="2030-12-31">
      <help>Select the earliest and latest dates to include comments posted in that range.</help>
      <suggest default="{'min': '2000-01-01', 'max': '2030-12-31'}" />
    </dateRangeParam>

    <enumParam name="project_id" prompt="Project" quote="true" multiPick="true">
      <help>
        Project the comment was made on. 
      </help>
      <enumList>
        <enumValue includeProjects="MicrosporidiaDB, UniDB">
          <term>MicrosporidiaDB</term>
          <internal>MicrosporidiaDB</internal>
        </enumValue>
        <enumValue includeProjects="TriTrypDB, UniDB">
          <term>TriTrypDB</term>
          <internal>TriTrypDB</internal>
        </enumValue>
        <enumValue includeProjects="FungiDB, UniDB">
          <term>FungiDB</term>
          <internal>FungiDB</internal>
        </enumValue>
        <enumValue includeProjects="VectorBase, UniDB">
          <term>VectorBase</term>
          <internal>VectorBase</internal>
        </enumValue>
        <enumValue includeProjects="PlasmoDB, UniDB">
          <term>PlasmoDB</term>
          <internal>PlasmoDB</internal>
        </enumValue>
        <enumValue includeProjects="AmoebaDB, UniDB">
          <term>AmoebaDB</term>
          <internal>AmoebaDB</internal>
        </enumValue>
        <enumValue includeProjects="CryptoDB, UniDB">
          <term>CryptoDB</term>
          <internal>CryptoDB</internal>
        </enumValue>
        <enumValue includeProjects="GiardiaDB, UniDB">
          <term>GiardiaDB</term>
          <internal>GiardiaDB</internal>
        </enumValue>
        <enumValue includeProjects="ToxoDB, UniDB">
          <term>ToxoDB</term>
          <internal>ToxoDB</internal>
        </enumValue>
        <enumValue includeProjects="TrichDB, UniDB">
          <term>TrichDB</term>
          <internal>TrichDB</internal>
        </enumValue>
        <enumValue includeProjects="HostDB, UniDB">
          <term>HostDB</term>
          <internal>HostDB</internal>
        </enumValue>
        <enumValue includeProjects="PiroplasmaDB, UniDB">
          <term>PiroplasmaDB</term>
          <internal>PiroplasmaDB</internal>
        </enumValue>
      </enumList>
    </enumParam>

    <stringParam name="user_name"
                 prompt="User Name"
                 number="false">
      <help>Search by the commenting user's name. Asterisks can be used as wildcards (e.g. "*smith*").</help>
      <suggest default="*"/>
    </stringParam>

    <stringParam name="organization"
                 prompt="Organization"
                 number="false">
      <help>Search by the commenting user's organization. Asterisks can be used as wildcards (e.g. "*university*").</help>
      <suggest default="*"/>
    </stringParam>

    <stringParam name="email"
                 prompt="Email"
                 number="false">
      <help>Search by the commenting user's email. Asterisks can be used as wildcards (e.g. "*@example.com").</help>
      <suggest default="*"/>
    </stringParam>

    <flatVocabParam name="type"
                    queryRef="UserCommentVQ.CommentTarget"
                    prompt="Type"
                    multiPick="false">
      <help>Select the type of record the comment was made on.</help>
      <suggest selectMode="first"/>
    </flatVocabParam>

    <enumParam name="is_ai_generated"
               prompt="AI Generated?"
               multiPick="false"
               quote="true">
      <help>Restrict to comments that were (or were not) AI-generated.</help>
      <enumList>
        <enumValue default="true">
          <display>Any</display>
          <term>Any</term>
          <internal>Any</internal>
        </enumValue>
        <enumValue>
          <display>Yes</display>
          <term>Yes</term>
          <internal>Yes</internal>
        </enumValue>
        <enumValue>
          <display>No</display>
          <term>No</term>
          <internal>No</internal>
        </enumValue>
      </enumList>
    </enumParam>

  </paramSet>

  <querySet name="UserCommentVQ" queryType="vocab" isCacheable="true">

    <sqlQuery name="CommentTarget">
      <column name="internal"/>
      <column name="term"/>
      <column name="display"/>
      <sql>
        <![CDATA[
          SELECT comment_target_id AS internal,
                 comment_target_id AS term,
                 comment_target_name AS display
          FROM @REMOTE_COMMENT_SCHEMA@comment_target
          WHERE comment_target_id = 'gene' or comment_target_id = 'genomic'
          ORDER BY display
        ]]>
      </sql>
    </sqlQuery>

  </querySet>

</wdkModel>
