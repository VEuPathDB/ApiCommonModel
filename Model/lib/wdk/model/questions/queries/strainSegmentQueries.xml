<wdkModel>

  <querySet name="StrainSegmentId" queryType="id" isCacheable="true">

    <!-- Three gates, all as filters so bad input returns zero rows:
           1. source_id  - the reference sequence exists (dots.ExternalNaSequence.source_id)
           2. range      - 1 <= start <= end <= ens.length
           3. EXISTS     - the strain has indel data on this very sequence, matched
                           on na_sequence_id
         Gate 3 subsumes the organism check the old version did explicitly: if the
         strain has indel rows on that sequence then strain and sequence are
         consistent by construction, which is stronger than validating against a
         supplied organism. It is scoped by na_sequence_id, never by strain name
         alone: 126 strain names map to more than one organism.

         project_id comes from apidb.organism.project_name rather than
         @PROJECT_ID@: it is unpartitioned, correct on every project, and avoids
         the per-project query duplication that forces DynSpan to maintain
         UniDB-specific variants. -->
    <sqlQuery name="StrainSegmentsByRefSegment" doNotTest="true">
      <paramRef ref="StrainSegmentParams.strain" quote="true"/>
      <paramRef ref="sharedParams.sequenceId"/>
      <paramRef ref="sharedParams.start_point" default="1"/>
      <paramRef ref="sharedParams.end_point_segment"/>
      <paramRef ref="SpanParams.sequence_strand"/>

      <column name="source_id"/>
      <column name="project_id"/>

      <sql>
        <![CDATA[
          SELECT CONCAT($$strain$$, ':', seg.ref_seq, ':',
                        seg.ref_start, '-', seg.ref_end, ':',
                        $$sequence_strand$$)              AS source_id
               , seg.project_id
          FROM (
            SELECT ens.source_id                          AS ref_seq
                 , o.project_name                         AS project_id
                 , $$start_point$$::integer               AS ref_start
                 , CASE WHEN $$end_point_segment$$::integer = 0
                          THEN ens.length::integer
                        ELSE $$end_point_segment$$::integer
                   END                                     AS ref_end
                 , ens.length::integer                     AS seq_length
                 , ens.na_sequence_id
            FROM dots.ExternalNaSequence ens
               , apidb.organism o
            WHERE o.taxon_id = ens.taxon_id
              AND ens.source_id = $$sequenceId$$
          ) seg
          WHERE seg.ref_start >= 1
            AND seg.ref_end   >= seg.ref_start
            AND seg.ref_end   <= seg.seq_length
            AND EXISTS (
                  SELECT 1
                  FROM apidb.indel i
                     , study.protocolappnode pan
                  WHERE i.protocol_app_node_id = pan.protocol_app_node_id
                    AND i.na_sequence_id = seg.na_sequence_id
                    AND pan.name = CONCAT($$strain$$, '_Indel')
                )
        ]]>
      </sql>
    </sqlQuery>

  </querySet>

</wdkModel>
