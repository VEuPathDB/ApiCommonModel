create table :SCHEMA.TranscriptAttributesThin_np as
select source_id, gene_source_id, project_id, org_abbrev, aa_sequence_id, modification_date
from :SCHEMA.transcriptattributes_p;

update :SCHEMA.TranscriptAttributesThin_np set modification_date = current_timestamp;

-- Analyze table after creation since it won't be touched after.
ANALYZE :SCHEMA.TranscriptAttributesThin_np;